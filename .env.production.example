# Copie para .env na VPS (chmod 600). Nunca versionar o .env real.

# Subdomínio com registro DNS tipo A apontando para o IP da VPS.
API_DOMAIN=

# Gere com: openssl rand -hex 24  (hex evita caracteres especiais na URL do banco)
POSTGRES_PASSWORD=

# Valores do aplicativo Meta.
META_APP_SECRET=
# Gere com: openssl rand -hex 24
META_WEBHOOK_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_ALLOWED_PAGE_IDS=
META_FORM_ID=1030408329895026
META_GRAPH_API_VERSION=v27.0

# Envio ao Syonet: false desliga (padrão se ausente). Ligar só com SYONET_* completos e leads antigos em revisão (send_hold).
SYONET_SEND_ENABLED=false

# Retenção LGPD (padrões): PII 30 dias após envio / 90 dias sem envio; lead sem PII 24 meses.
# PII_RETENTION_SENT_DAYS=30
# PII_RETENTION_UNSENT_DAYS=90
# OPERATIONAL_RETENTION_MONTHS=24

# Conferência com a Meta (lista do formulário x banco) e alertas da aba Saúde.
# Leads da Meta a partir desta data que o webhook perdeu são recuperados (nunca vão ao Syonet).
# RECONCILIATION_RECOVER_SINCE=2026-11-23T23:40:00Z
# RECONCILIATION_INTERVAL_MINUTES=15
# ALERT_MISSING_LEAD_MINUTES=15
# Opcional: aviso também no Telegram (sem isso, alertas ficam só no painel e nos logs).
# ALERT_TELEGRAM_BOT_TOKEN=
# ALERT_TELEGRAM_CHAT_ID=

# Homologação controlada do Syonet: só estes leadgen_id são enviados.
# SYONET_SEND_ONLY_LEADGEN_IDS=
# SYONET_HOMOLOGATION_MEDIA=FACEBOOK

# Alerta de disco da VPS (porcentagem de uso)
# STORAGE_WARN_PERCENT=70
# STORAGE_CRITICAL_PERCENT=85
