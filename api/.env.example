NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgres://synclead:change-me@localhost:5432/synclead

# Configure these from the Meta app. Never commit real values.
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_FORM_ID=1030408329895026
META_GRAPH_API_VERSION=v27.0
META_ALLOWED_PAGE_IDS=

# Keep Syonet delivery disabled until its endpoint, authentication, and behavior are confirmed.
SYONET_SEND_ENABLED=false
# Base: https://grupocacel.syonet.com; endpoint POST /api/lead com Basic (ver Documentação/10-homologacao-syonet.md).
SYONET_LEAD_API_URL=
# apikey (cabeçalho apikey) ou basic (Authorization: Basic). Ainda não definido pela Syonet.
SYONET_AUTH_MODE=apikey
SYONET_API_KEY=
SYONET_BASIC_USER=
SYONET_BASIC_PASSWORD=
# ddd_numero (padrão) ou e164 (opcional; formato ainda não confirmado pela Syonet).
SYONET_PHONE_FORMAT=ddd_numero
SYONET_EVENT_GROUP=OPORTUNIDADE
SYONET_EVENT_TYPE=CONSORCIO WEB
SYONET_SOURCE=INTERNET
SYONET_DAYS_TO_UPDATE_OPEN_EVENT=
